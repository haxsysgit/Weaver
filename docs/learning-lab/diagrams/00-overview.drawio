<mxfile host="app.diagrams.net" agent="weaver-learning-lab">
  <diagram id="lab-00" name="00-overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- band: browser -->
        <mxCell id="browserBand" value="BROWSER — React PWA (module 01)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;verticalAlign=top;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="browserBox" value="chatApi.ts + useChatController.ts&#xa;StreamEvent: delta | completed | interrupted | failed | tool&#xa;TurnState: idle | streaming | cancelling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="browserRest" value="POST /api/conversations/{id}/turns  →  202 (turn runs server-side)&#xa;GET /api/conversations/{id}/stream  →  SSE (EventSource, Last-Event-ID resume)&#xa;POST /api/conversations/{id}/cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=left" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="browserTools" value="web/frontend/lib/chatApi.ts&#xa;hooks/useChatController.ts" style="text;html=1;align=left;fontSize=10;fontStyle=2;fillColor=none" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="260" height="16" as="geometry" />
        </mxCell>

        <!-- band: web layer -->
        <mxCell id="webBand" value="WEB LAYER — FastAPI + runtime wiring (modules 01, 02)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#1976D2;verticalAlign=top;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="appBox" value="web/app.py — create_app(runtime)&#xa;routes, SSE streams, LOCAL_HOSTS origin checks&#xa;MAX_MESSAGE_CHARS = 32_000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="runtimeBox" value="chat_runtime.py — ChatRuntime&#xa;open_chat_runtime(state_dir, live=False, surface=&#quot;web&quot;)&#xa;builds provider, prompts, tool registry, SessionWeave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sessionBox" value="conversation/session.py — SessionWeave&#xa;send(): interrupted check → start_turn → run_turn_in_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="790" y="230" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="coordBox" value="conversation/coordinator.py — RunCoordinator&#xa;start_conversation_and_turn, _tx (BEGIN IMMEDIATE)&#xa;settle_tool, complete_run, mark_interrupted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="runnerBox" value="conversation/runner.py — ConversationRunner&#xa;run_turn_in_run: phases queued → running → completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="790" y="320" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- band: engine -->
        <mxCell id="engineBand" value="ENGINE — context, turn loop, model, tools (modules 03, 04, 05, 06)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF8F3;strokeColor=#E65100;verticalAlign=top;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="assemblerBox" value="conversation/assembler.py — ContextAssembler&#xa;token budget, drop-oldest blocks, pinned owner message&#xa;ContextSnapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="turnBox" value="agent/turn.py — run_turn&#xa;tool phase ↔ final answer phase&#xa;stop reasons, tool budget tiers,&#xa;working-note candidates, packet append" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="modelBox" value="model_layer/ — ModelLayer&#xa;ModelSpec, ModelRequest, ModelResponse&#xa;DeepSeekProvider wire payload&#xa;FakeModelProvider (offline runs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="770" y="470" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="toolsBox" value="agent/tools.py — ToolRegistry&#xa;dispatch gates: unknown → inactive → effect → JSON → cancel&#xa;EffectKind, ToolExecutionPolicy.read_only()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="70" y="580" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="retrievalBox" value="retrieval/tools.py — five reading tools&#xa;semantic_search, read_chapters, find_text&#xa;browse_chapters, who_is (all READ)&#xa;durable evidence: chapter, lines, hash, handle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="420" y="580" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="libraryBox" value="retrieval/library.py + packet.py&#xa;ChapterIndex, EntityMap, ConnectionGraph&#xa;reading packet caps per tier&#xa;(PACKET_CHAR_CAPS 180k/360k/700k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="770" y="580" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- band: persistence -->
        <mxCell id="storeBand" value="PERSISTENCE — SQLite + preferences (module 07)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F9F3;strokeColor=#2E7D32;verticalAlign=top;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="1320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sqliteBox" value="conversation/schema.py + repository.py&#xa;relationship → conversation → turn → run → run_event&#xa;conversation_item (sequence, kind, body)&#xa;only durable evidence ever persists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="70" y="770" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="prefsBox" value="PreferencesStore (weaver.sqlite3)&#xa;reader_chapter, spoiler_mode, tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="540" y="770" width="300" height="90" as="geometry" />
        </mxCell>

