        <mxCell id="band2" value="EVERY WRITE IS ONE TRANSACTION (coordinator.py _tx)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;verticalAlign=top;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1120" height="120" as="geometry" />
        </mxCell>
        <mxCell id="txBox" value="BEGIN IMMEDIATE → writes → commit; any exception → rollback&#xa;start_conversation_and_turn creates relationship + conversation +&#xa;turn + run atomically&#xa;dangling transactions brick the connection — _tx is the only path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;align=left" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="700" height="70" as="geometry" />
