        <mxCell id="flowBox" value="semantic_search(&quot;who killed the hunting party leader&quot;) →&#xa;read_chapters(&quot;novel:0098:3-4&quot;) → final answer&#xa;model_steps 3, tool_starts 2, exit completed&#xa;&#xa;search hit: score 0.606, passage_handle novel:0098:2-4, source_hash d9a88a7d…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;align=left" vertex="1" parent="1">
