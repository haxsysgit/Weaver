        </mxCell>
        <mxCell id="fakeBox" value="FakeModelProvider: records every call verbatim&#xa;(FakeModelCall.calls), replays scripted ModelResponses&#xa;cyclically, aborts if the cancel event is set&#xa;→ evidence/05-wire/03-layer-roundtrip.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;align=left" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="layerBox" value="ModelLayer guards the protocol: exactly one&#xa;terminal response per stream, no data after&#xa;termination, output_tokens from request or default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;align=left" vertex="1" parent="1">
