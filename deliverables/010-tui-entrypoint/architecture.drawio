<mxfile host="app.diagrams.net">
  <diagram id="plan-010-architecture" name="Plan 010 - TUI entrypoint">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cli" value="weaver chat [--fake]&#10;(argparse subcommand, live is default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="startup config + mode&#10;load_startup_config(): env &gt; .env &gt; .weaver/config.toml&#10;live default (no key anywhere: exit 2)&#10;--fake: scripted, never constructs DeepSeekProvider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="build" value="SessionWeave(state_dir, model,&#10;chat registry, maintenance policy)&#10;.open() -&gt; start_conversation(&quot;&quot;)&#10;(^n later creates more conversations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="app" value="WeaverChat(sw, conv_id, mode_label)&#10;await app.run_async()  (same event loop)&#10;exit prints the session line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="welcome" value="welcome line in log&#10;cleared by first submit (pi-style)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="log" value="RichLog #chat-log&#10;escaped user lines · markdown replies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="stream" value="Static #stream (hidden)&#10;live text deltas while model streams&#10;cleared and hidden after the turn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="input" value="ChatInput #input (TextArea)&#10;enter submits (bubbles to app binding)&#10;shift+enter inserts a newline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="290" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="status" value="StatusBar (one line)&#10;spinner while busy · mode · ctx meter&#10;hints: ^c cancel · ^h history · ^q quit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="380" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="send" value="action_submit_turn&#10;cancel_event = asyncio.Event()&#10;await sw.send(conv_id, text, cancel_event, on_delta)&#10;footer: set_context(token_count, token_budget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="500" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="actions" value="actions&#10;^c cancel_turn (priority, never task.cancel)&#10;^h show_history&#10;^r resume (picker) · ^n new conversation&#10;^q quit (base priority)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pickers" value="screens (dumb views)&#10;RunHistoryScreen (^h): recent runs, esc/q&#10;ConversationPickerScreen (^r): recent&#10;conversations, enter picks, esc/q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="780" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="weaver.sqlite3 (state dir)&#10;conversations, runs, items persist&#10;list_conversations / list_recent_turns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="chat registry (maintenance policy)&#10;echo · inspect_novel_corpus&#10;build_novel_packet · export_novel&#10;fetch/update NEVER registered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="640" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="cli" target="mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="mode" target="build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="build" target="app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="app" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="input" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="send" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="send" target="tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="actions" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="actions" target="pickers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pickers" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="status" target="send">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
