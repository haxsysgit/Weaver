          <mxGeometry x="40" y="410" width="390" height="230" as="geometry" />
        </mxCell>
        <mxCell id="runtime-node" value="shared runtime, surface web&#xa;zero tools, read-only policy&#xa;no conversation on open&#xa;mode label live or fake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8f7;strokeColor=#9673a6;" vertex="1" parent="runtime">
          <mxGeometry x="30" y="60" width="330" height="125" as="geometry" />
