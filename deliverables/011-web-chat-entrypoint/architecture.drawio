          <mxGeometry x="505" y="410" width="390" height="230" as="geometry" />
        </mxCell>
        <mxCell id="session-node" value="send with on_delta streaming&#xa;cancel_event cooperative,&#xa;never task.cancel on model work&#xa;token count from snapshot&#xa;load_transcript, conversation_exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8f7;strokeColor=#9673a6;" vertex="1" parent="session">
