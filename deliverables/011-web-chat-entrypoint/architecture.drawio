          <mxGeometry x="970" y="90" width="390" height="210" as="geometry" />
        </mxCell>
        <mxCell id="browser-node" value="plain HTML CSS JS, no CDN&#xa;textContent rendering only&#xa;capsule composer, user bubble&#xa;bare assistant text and copy&#xa;localStorage: active id only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;" vertex="1" parent="browser">
          <mxGeometry x="30" y="55" width="330" height="130" as="geometry" />
