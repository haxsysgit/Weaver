          <mxGeometry x="505" y="90" width="390" height="210" as="geometry" />
        </mxCell>
        <mxCell id="api-node" value="conversation create and list&#xa;SSE turns: delta then completed /&#xa;interrupted / failed&#xa;cooperative cancel route&#xa;422 blank-long 404 unknown 409 busy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#6c8ebf;" vertex="1" parent="api">
          <mxGeometry x="30" y="55" width="330" height="130" as="geometry" />
