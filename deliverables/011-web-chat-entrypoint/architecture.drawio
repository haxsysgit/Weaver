          <mxGeometry x="40" y="90" width="390" height="210" as="geometry" />
        </mxCell>
        <mxCell id="launch-node" value="weaver web [--fake] [--port]&#xa;live default; exit 2 without key&#xa;before any state dir or socket&#xa;binds 127.0.0.1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="launch">
          <mxGeometry x="30" y="65" width="330" height="100" as="geometry" />
        </mxCell>
