        </mxCell>
        <mxCell id="c" value="RunCoordinator.start_turn&#10;owner item in one tx&#10;(turn_id, run_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="610" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d" value="ConversationRunner.run_turn_in_run&#10;(conversation_id, run_id, turn_id, cancel_event)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e" value="load all items&#10;_items_to_messages&#10;(pinned mapping table)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="610" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f" value="run_turn (agent)&#10;model stream + ToolRegistry.dispatch&#10;cancel_event (cooperative only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g" value="persist callback seam (async)&#10;_message_to_item -&gt; _tx -&gt; ItemRecord&#10;one message per transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="200" height="70" as="geometry" />
