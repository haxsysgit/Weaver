        <mxCell id="h" value="COMPLETED -&gt; complete_run(flag=True)&#10;else -&gt; mark_interrupted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="200" height="50" as="geometry" />
        </mxCell>
