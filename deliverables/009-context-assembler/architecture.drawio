        <mxCell id="a" value="ConversationRunner.run_turn_in_run()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="330" y="40" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b" value="load all items&#10;(ConversationRepository.load_items)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
