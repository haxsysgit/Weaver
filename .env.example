DEEPSEEK_KEY=
FIRECRAWL_API_KEY=
WEAVER_STATE_DIR=
WEAVER_CORPUS_STATE_DIR=
# Voice pack: buddy (chat) or storyteller (prose and fan fiction).
WEAVER_VOICE=buddy
# Local owner switch: 1 lets chats opened directly on this machine use
# DEEPSEEK_KEY with no daily limit. Never set it on a shared or tunnelled
# server; forwarded requests are refused the switch, but keep it local.
WEAVER_LOCAL_OWNER_KEY=0
WEAVER_SPONSORED_ENABLED=0
WEAVER_SPONSORED_PASS_SECRET=
# Recheck the DeepSeek price version and set a future date before enabling.
WEAVER_SPONSORED_PRICE_VALID_UNTIL=2026-12-31T00:00:00+00:00
WEAVER_TRUSTED_PROXY_ADDRESSES=
WEAVER_ORIGINAL_ADDRESS_HEADER=
